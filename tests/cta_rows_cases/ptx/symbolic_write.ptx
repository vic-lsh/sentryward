.version 8.8
.target sm_90a
.address_size 64

.visible .entry symbolic_write(
	.param .u64 symbolic_write_param_0,
	.param .u64 symbolic_write_param_1
)
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<16>;

	ld.param.u64 	%rd1, [symbolic_write_param_0];
	ld.param.u64 	%rd2, [symbolic_write_param_1];
	cvta.to.global.u64 	%rd3, %rd1;
	cvta.to.global.u64 	%rd4, %rd2;
	mov.u32 	%r1, %ctaid.y;
	mov.u32 	%r2, %tid.x;
	mul.wide.u32 	%rd5, %r1, 128;
	mul.wide.u32 	%rd6, %r2, 4;
	add.s64 	%rd7, %rd5, %rd6;
	mul.wide.u32 	%rd10, %r1, 8;
	add.s64 	%rd11, %rd4, %rd10;
	ld.global.u64 	%rd12, [%rd11];
	shl.b64 	%rd13, %rd12, 7;
	add.s64 	%rd14, %rd3, %rd13;
	add.s64 	%rd15, %rd14, %rd6;
	st.global.u32 	[%rd15], %r2;
	ret;
}
