.version 8.8
.target sm_90a
.address_size 64

.visible .entry rows_next(
	.param .u64 rows_next_param_0,
	.param .u64 rows_next_param_1
)
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<16>;

	ld.param.u64 	%rd1, [rows_next_param_0];
	ld.param.u64 	%rd2, [rows_next_param_1];
	cvta.to.global.u64 	%rd3, %rd1;
	cvta.to.global.u64 	%rd4, %rd2;
	mov.u32 	%r1, %ctaid.y;
	mov.u32 	%r2, %tid.x;
	mul.wide.u32 	%rd5, %r1, 128;
	mul.wide.u32 	%rd6, %r2, 4;
	add.s64 	%rd7, %rd5, %rd6;
	add.s64 	%rd8, %rd3, %rd7;
	ld.global.u32 	%r3, [%rd8+128];
	st.global.u32 	[%rd8], %r3;
	ret;
}
