.version 8.8
.target sm_90a
.address_size 64

.visible .entry smid(
	.param .u64 smid_param_0,
	.param .u64 smid_param_1
)
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<16>;

	ld.param.u64 	%rd1, [smid_param_0];
	ld.param.u64 	%rd2, [smid_param_1];
	cvta.to.global.u64 	%rd3, %rd1;
	cvta.to.global.u64 	%rd4, %rd2;
	mov.u32 	%r1, %ctaid.y;
	mov.u32 	%r2, %tid.x;
	mul.wide.u32 	%rd5, %r1, 128;
	mul.wide.u32 	%rd6, %r2, 4;
	add.s64 	%rd7, %rd5, %rd6;
	mov.u32 	%r4, %smid;
	setp.eq.u32 	%p1, %r4, 0;
	@%p1 bra 	$L__skip;
	add.s64 	%rd8, %rd4, %rd7;
	ld.global.u32 	%r3, [%rd8];
	add.s64 	%rd9, %rd3, %rd7;
	st.global.u32 	[%rd9], %r3;
$L__skip:
	ret;
}
