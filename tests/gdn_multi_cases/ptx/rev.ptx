// Hand-written (docs/design/gdn-multi-request.md, A2 controls): thread 0 of each one-warp CTA reads 4 bytes of
// state[tab[blockIdx.x]] and stores them to out[blockIdx.x].
.version 8.8
.target sm_90a
.address_size 64

.visible .entry k_rev(
	.param .u64 .ptr .align 1 k_rev_param_0,
	.param .u64 .ptr .align 1 k_rev_param_1,
	.param .u64 .ptr .align 1 k_rev_param_2
)
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<5>;
	.reg .b64 	%rd<10>;

	mov.u32 	%r4, %tid.x;
	setp.ne.s32 	%p1, %r4, 0;
	@%p1 bra 	$L_done;
	ld.param.u64 	%rd1, [k_rev_param_0];
	ld.param.u64 	%rd2, [k_rev_param_1];
	ld.param.u64 	%rd3, [k_rev_param_2];
	cvta.to.global.u64 	%rd4, %rd1;
	cvta.to.global.u64 	%rd5, %rd2;
	cvta.to.global.u64 	%rd6, %rd3;
	mov.u32 	%r1, %ctaid.x;
	mul.wide.u32 	%rd7, %r1, 4;
	add.s64 	%rd8, %rd4, %rd7;
	ld.global.u32 	%r2, [%rd8];
	mul.wide.u32 	%rd9, %r2, 4;
	add.s64 	%rd9, %rd5, %rd9;
	ld.global.u32 	%r3, [%rd9];
	add.s64 	%rd7, %rd6, %rd7;
	st.global.u32 	[%rd7], %r3;
$L_done:
	ret;
}
