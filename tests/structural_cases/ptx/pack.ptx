.version 8.0
.target sm_90
.address_size 64
.visible .entry pack(.param .u64 a, .param .u64 b, .param .u64 p, .param .u64 y) {
.reg .b32 %r<8>;
.reg .b16 %h<2>;
.reg .f32 %f<2>;
.reg .b64 %rd<12>;
ld.param.u64 %rd1, [a];
ld.param.u64 %rd2, [b];
ld.param.u64 %rd3, [p];
ld.param.u64 %rd4, [y];
mov.u32 %r1, %tid.x;
mul.wide.u32 %rd5, %r1, 4;
add.u64 %rd6, %rd1, %rd5;
add.u64 %rd7, %rd2, %rd5;
add.u64 %rd8, %rd3, %rd5;
add.u64 %rd9, %rd4, %rd5;
ld.global.u32 %r2, [%rd6];
ld.global.u32 %r3, [%rd7];
and.b32 %r4, %r2, 65535;
and.b32 %r5, %r3, 4294901760;
or.b32 %r6, %r4, %r5;
st.global.u32 [%rd8], %r6;
ld.global.u16 %h1, [%rd8];
cvt.f32.u16 %f1, %h1;
st.global.f32 [%rd9], %f1;
ret;
}
