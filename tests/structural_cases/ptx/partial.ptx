//
// Partial-operand controls (tests/test_structural_native.py; emitted by a script, kept as text).
// Each kernel stores p = a + b, reloads p at full width as u32, applies one operation and stores
// its bits as y. Term pack: P(a, b) -> p, C(p) -> y. A kernel whose operation uses only part of
// p's bits must be refused (partial_operand); _full kernels use every bit and match;
// partial_stored_half reads p's low half from memory (partial_stored_read).
//

.version 8.8
.target sm_90a
.address_size 64

// partial_and_mask: the round-6 reproducer: and with 0xffff keeps p's low half
.visible .entry partial_and_mask(.param .u64 a, .param .u64 b, .param .u64 p, .param .u64 y)
{
	.reg .b32 %r<8>;
	.reg .b16 %h<4>;
	.reg .f32 %f<8>;
	.reg .b64 %rd<12>;
	.reg .pred %q<2>;
	ld.param.u64 %rd1, [a];
	ld.param.u64 %rd2, [b];
	ld.param.u64 %rd3, [p];
	ld.param.u64 %rd4, [y];
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd5, %r1, 4;
	add.u64 %rd6, %rd1, %rd5;
	add.u64 %rd7, %rd2, %rd5;
	add.u64 %rd8, %rd3, %rd5;
	add.u64 %rd9, %rd4, %rd5;
	ld.global.f32 %f1, [%rd6];
	ld.global.f32 %f2, [%rd7];
	add.f32 %f3, %f1, %f2;
	st.global.f32 [%rd8], %f3;
	ld.global.u32 %r2, [%rd8];
	and.b32 %r3, %r2, 65535;
	mov.b32 %f4, %r3;
	st.global.f32 [%rd9], %f4;
	ret;
}

// partial_or_mask: or with 0xffff0000 forces the high half
.visible .entry partial_or_mask(.param .u64 a, .param .u64 b, .param .u64 p, .param .u64 y)
{
	.reg .b32 %r<8>;
	.reg .b16 %h<4>;
	.reg .f32 %f<8>;
	.reg .b64 %rd<12>;
	.reg .pred %q<2>;
	ld.param.u64 %rd1, [a];
	ld.param.u64 %rd2, [b];
	ld.param.u64 %rd3, [p];
	ld.param.u64 %rd4, [y];
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd5, %r1, 4;
	add.u64 %rd6, %rd1, %rd5;
	add.u64 %rd7, %rd2, %rd5;
	add.u64 %rd8, %rd3, %rd5;
	add.u64 %rd9, %rd4, %rd5;
	ld.global.f32 %f1, [%rd6];
	ld.global.f32 %f2, [%rd7];
	add.f32 %f3, %f1, %f2;
	st.global.f32 [%rd8], %f3;
	ld.global.u32 %r2, [%rd8];
	or.b32 %r3, %r2, 4294901760;
	mov.b32 %f4, %r3;
	st.global.f32 [%rd9], %f4;
	ret;
}

// partial_xor_full: positive: xor with a constant uses every bit
.visible .entry partial_xor_full(.param .u64 a, .param .u64 b, .param .u64 p, .param .u64 y)
{
	.reg .b32 %r<8>;
	.reg .b16 %h<4>;
	.reg .f32 %f<8>;
	.reg .b64 %rd<12>;
	.reg .pred %q<2>;
	ld.param.u64 %rd1, [a];
	ld.param.u64 %rd2, [b];
	ld.param.u64 %rd3, [p];
	ld.param.u64 %rd4, [y];
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd5, %r1, 4;
	add.u64 %rd6, %rd1, %rd5;
	add.u64 %rd7, %rd2, %rd5;
	add.u64 %rd8, %rd3, %rd5;
	add.u64 %rd9, %rd4, %rd5;
	ld.global.f32 %f1, [%rd6];
	ld.global.f32 %f2, [%rd7];
	add.f32 %f3, %f1, %f2;
	st.global.f32 [%rd8], %f3;
	ld.global.u32 %r2, [%rd8];
	xor.b32 %r3, %r2, 2147483648;
	mov.b32 %f4, %r3;
	st.global.f32 [%rd9], %f4;
	ret;
}

// partial_shl: shl by 16 drops the high half
.visible .entry partial_shl(.param .u64 a, .param .u64 b, .param .u64 p, .param .u64 y)
{
	.reg .b32 %r<8>;
	.reg .b16 %h<4>;
