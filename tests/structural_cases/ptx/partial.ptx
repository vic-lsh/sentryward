	ld.param.u64 %rd2, [b];
	ld.param.u64 %rd3, [p];
	ld.param.u64 %rd4, [y];
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd5, %r1, 4;
	add.u64 %rd6, %rd1, %rd5;
	add.u64 %rd7, %rd2, %rd5;
	add.u64 %rd8, %rd3, %rd5;
	add.u64 %rd9, %rd4, %rd5;
	ld.global.f32 %f1, [%rd6];
	ld.global.f32 %f2, [%rd7];
	add.f32 %f3, %f1, %f2;
	st.global.f32 [%rd8], %f3;
	ld.global.u32 %r2, [%rd8];
	shl.b32 %r3, %r2, 16;
	mov.b32 %f4, %r3;
	st.global.f32 [%rd9], %f4;
	ret;
}

