.visible .entry partial_four_bit_mask(.param .u64 a, .param .u64 b, .param .u64 p, .param .u64 y)
{
	.reg .b32 %r<8>;
	.reg .b16 %h<4>;
	.reg .f32 %f<8>;
	.reg .b64 %rd<12>;
	.reg .pred %q<2>;
	ld.param.u64 %rd1, [a];
	ld.param.u64 %rd2, [b];
	ld.param.u64 %rd3, [p];
	ld.param.u64 %rd4, [y];
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd5, %r1, 4;
	mul.wide.u32 %rd10, %r1, 2;
	add.u64 %rd6, %rd1, %rd5;
	add.u64 %rd7, %rd2, %rd5;
	add.u64 %rd8, %rd3, %rd5;
	add.u64 %rd9, %rd4, %rd5;
	ld.global.f32 %f1, [%rd6];
	ld.global.f32 %f2, [%rd7];
	add.f32 %f3, %f1, %f2;
	st.global.f32 [%rd8], %f3;
	ld.global.u32 %r2, [%rd8];
	shr.u32 %r4, %r2, 1;
	xor.b32 %r4, %r2, %r4;
	shr.u32 %r5, %r2, 2;
	shr.u32 %r6, %r2, 3;
	xor.b32 %r5, %r5, %r6;
	and.b32 %r5, %r5, %r4;
	and.b32 %r3, %r2, %r5;
	mov.b32 %f4, %r3;
	st.global.f32 [%rd9], %f4;
	ret;
}
