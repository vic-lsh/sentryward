	mov.b32 %r3, %f6;
	mov.b32 %f4, %r3;
	st.global.f32 [%rd9], %f4;
	ret;
}

// partial_selp_narrow: selp on a truncated value (its condition on the same)
.visible .entry partial_selp_narrow(.param .u64 a, .param .u64 b, .param .u64 p, .param .u64 y)
{
	.reg .b32 %r<8>;
	.reg .b16 %h<4>;
	.reg .f32 %f<8>;
	.reg .b64 %rd<12>;
	.reg .pred %q<2>;
	ld.param.u64 %rd1, [a];
