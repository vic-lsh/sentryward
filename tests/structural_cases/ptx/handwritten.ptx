//
// Hand-written PTX for tests/test_structural_native.py (not compiled from roles.cu: nvcc would
// fold the cases away).
//
// chain_neg_ex2: the round-4 fork review's reproducer (chain_pos with y = p * ex2(q), q = 2p):
// p reaches y through an ex2 above q's cut.
// sel_pos_component / sel_neg_component: a stored producer's value and a primitive's operand that
// are conversions of one node result and instance and differ only in the selected component.
//

.version 8.8
.target sm_90a
.address_size 64

.visible .entry chain_neg_ex2(
	.param .u64 chain_neg_ex2_param_0,
	.param .u64 chain_neg_ex2_param_1,
	.param .u64 chain_neg_ex2_param_2,
	.param .u64 chain_neg_ex2_param_3
)
{
	.reg .f32 	%f<6>;
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<14>;


	ld.param.u64 	%rd1, [chain_neg_ex2_param_0];
	ld.param.u64 	%rd2, [chain_neg_ex2_param_1];
	ld.param.u64 	%rd3, [chain_neg_ex2_param_2];
	ld.param.u64 	%rd4, [chain_neg_ex2_param_3];
	cvta.to.global.u64 	%rd5, %rd4;
	cvta.to.global.u64 	%rd6, %rd3;
	cvta.to.global.u64 	%rd7, %rd2;
	cvta.to.global.u64 	%rd8, %rd1;
	mov.u32 	%r1, %tid.x;
	mul.wide.s32 	%rd9, %r1, 4;
	add.s64 	%rd10, %rd8, %rd9;
	ld.global.f32 	%f1, [%rd10];
	fma.rn.f32 	%f2, %f1, %f1, 0f3F800000;
	add.s64 	%rd11, %rd7, %rd9;
	st.global.f32 	[%rd11], %f2;
	add.f32 	%f3, %f2, %f2;
	add.s64 	%rd12, %rd6, %rd9;
	st.global.f32 	[%rd12], %f3;
	ex2.approx.f32 	%f5, %f3;
	mul.f32 	%f4, %f2, %f5;
	add.s64 	%rd13, %rd5, %rd9;
	st.global.f32 	[%rd13], %f4;
	ret;

}


// a is rows of two bf16 (one 32-bit word per thread). p = f32(h0), y = f32(%h1) + b, where
// {h0, h1} is the word unpacked: both components have the whole word's leaves (a's row), and
// differ only in the selected component.
.visible .entry sel_pos_component(
	.param .u64 sel_pos_component_param_0,
	.param .u64 sel_pos_component_param_1,
	.param .u64 sel_pos_component_param_2,
	.param .u64 sel_pos_component_param_3
)
{
	.reg .f32 	%f<8>;
	.reg .b16 	%h<3>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<16>;

	ld.param.u64 	%rd1, [sel_pos_component_param_0];
	ld.param.u64 	%rd2, [sel_pos_component_param_1];
	ld.param.u64 	%rd3, [sel_pos_component_param_2];
	ld.param.u64 	%rd4, [sel_pos_component_param_3];
	cvta.to.global.u64 	%rd5, %rd1;
	cvta.to.global.u64 	%rd6, %rd2;
	cvta.to.global.u64 	%rd7, %rd3;
	cvta.to.global.u64 	%rd8, %rd4;
	mov.u32 	%r1, %tid.x;
	mul.wide.s32 	%rd9, %r1, 4;
	add.s64 	%rd10, %rd5, %rd9;
	ld.global.b32 	%r2, [%rd10];
	mov.b32 	{%h1, %h2}, %r2;
	cvt.f32.bf16 	%f1, %h1;
	add.s64 	%rd12, %rd7, %rd9;
	st.global.f32 	[%rd12], %f1;
	cvt.f32.bf16 	%f2, %h1;
	add.s64 	%rd13, %rd6, %rd9;
	ld.global.f32 	%f6, [%rd13];
	add.f32 	%f7, %f2, %f6;
	add.s64 	%rd14, %rd8, %rd9;
	st.global.f32 	[%rd14], %f7;
	ret;

}

// a is rows of two bf16 (one 32-bit word per thread). p = f32(h0), y = f32(%h2) + b, where
// {h0, h1} is the word unpacked: both components have the whole word's leaves (a's row), and
// differ only in the selected component.
.visible .entry sel_neg_component(
	.param .u64 sel_neg_component_param_0,
	.param .u64 sel_neg_component_param_1,
	.param .u64 sel_neg_component_param_2,
	.param .u64 sel_neg_component_param_3
)
{
	.reg .f32 	%f<8>;
	.reg .b16 	%h<3>;
	.reg .b32 	%r<3>;
	.reg .b64 	%rd<16>;

	ld.param.u64 	%rd1, [sel_neg_component_param_0];
	ld.param.u64 	%rd2, [sel_neg_component_param_1];
	ld.param.u64 	%rd3, [sel_neg_component_param_2];
	ld.param.u64 	%rd4, [sel_neg_component_param_3];
	cvta.to.global.u64 	%rd5, %rd1;
	cvta.to.global.u64 	%rd6, %rd2;
	cvta.to.global.u64 	%rd7, %rd3;
	cvta.to.global.u64 	%rd8, %rd4;
	mov.u32 	%r1, %tid.x;
	mul.wide.s32 	%rd9, %r1, 4;
	add.s64 	%rd10, %rd5, %rd9;
	ld.global.b32 	%r2, [%rd10];
	mov.b32 	{%h1, %h2}, %r2;
	cvt.f32.bf16 	%f1, %h1;
	add.s64 	%rd12, %rd7, %rd9;
	st.global.f32 	[%rd12], %f1;
	cvt.f32.bf16 	%f2, %h2;
	add.s64 	%rd13, %rd6, %rd9;
	ld.global.f32 	%f6, [%rd13];
	add.f32 	%f7, %f2, %f6;
	add.s64 	%rd14, %rd8, %rd9;
	st.global.f32 	[%rd14], %f7;
	ret;

}
