//
// Hand-written (Codex review of stage B): a loop's exported induction variable guards a store past
// the extent. n = hdr[0] in [1, 4] (premise); i counts 1.. until i == n, so i == n >= 1 at exit and
// the store to out[1] (out has 4 bytes) always executes: a violation.
//
.version 8.0
.target sm_90
.address_size 64

.visible .entry k_exit_iv(
	.param .u64 k_exit_iv_param_0,
	.param .u64 k_exit_iv_param_1
)
{
	.reg .pred 	%p<3>;
	.reg .b32 	%r<6>;
	.reg .b64 	%rd<5>;

	ld.param.u64 	%rd1, [k_exit_iv_param_0];
	ld.param.u64 	%rd2, [k_exit_iv_param_1];
	cvta.to.global.u64 	%rd3, %rd1;
	cvta.to.global.u64 	%rd4, %rd2;
	ld.global.u32 	%r1, [%rd3];
	mov.u32 	%r2, 0;
$L__loop:
	add.u32 	%r2, %r2, 1;
	setp.ne.u32 	%p1, %r2, %r1;
	@%p1 bra 	$L__loop;
	setp.ne.u32 	%p2, %r2, 0;
	mov.u32 	%r3, 1;
	@%p2 st.global.u32 	[%rd4+4], %r3;
	ret;
}
